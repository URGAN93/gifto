{
  "name": "gifto",
  "version": "0.1.0",
  "private": true,
  "overrides": { "xcode": { "uuid": "11.1.1" } },
  "description": "GIFTO shared web and Capacitor mobile app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-mobile.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:regression": "node scripts/test-regression.mjs",
    "verify": "npm run mobile:sync && npm test && npm run test:regression",
    "mobile:sync": "npm run build && cap sync",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "node scripts/android-open.mjs",
    "android:debug": "node scripts/android-debug.mjs",
    "android:devices": "node scripts/android-devices.mjs",
    "ios:add": "npm run build && cap add ios",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.1",
    "@supabase/supabase-js": "2.116.0",
    "jsqr": "1.4.0",
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  }
}
